#!/bin/bash
# start | stop | status for the wxbackup Go HTTP server.
# WeChat LAN ports 8011 (discovery) and 24011 (transfer) are protocol-fixed;
# this script only launches the app listener (default 20365).
set -u
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

APP_NAME="${TRIM_APPNAME:-wxbackup}"
APP_DEST="${TRIM_APPDEST:-/var/apps/${APP_NAME}/target}"
PKG_VAR="${TRIM_PKGVAR:-/var/apps/${APP_NAME}/var}"
PID_FILE="${PKG_VAR}/${APP_NAME}.pid"
LOG_FILE="${PKG_VAR}/${APP_NAME}.log"
BIN="${APP_DEST}/bin/wxbackup"
PORT="${WXBACKUP_PORT:-${TRIM_SERVICE_PORT:-20365}}"

# Prefer the declared data-share; fall back to persistent var/.
data_dir() {
  if [ -n "${WXBACKUP_DATA:-}" ]; then
    printf '%s' "$WXBACKUP_DATA"
    return
  fi
  local share="/var/apps/${APP_NAME}/share/data"
  if [ -d "$share" ]; then
    printf '%s' "$share"
    return
  fi
  if [ -n "${TRIM_DATA_SHARE_PATHS:-}" ]; then
    local first
    first="$(printf '%s' "$TRIM_DATA_SHARE_PATHS" | tr ',;' '\n' | awk 'NF{print; exit}')"
    if [ -n "$first" ]; then
      printf '%s' "$first"
      return
    fi
  fi
  printf '%s' "${PKG_VAR}/data"
}

log_msg() {
  mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || true
  echo "$(date '+%Y-%m-%d %H:%M:%S') - $*" >>"$LOG_FILE"
}

check_pid() {
  local pid="$1"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

status() {
  if [ -f "$PID_FILE" ]; then
    local pid
    pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
    if check_pid "$pid"; then
      return 0
    fi
    rm -f "$PID_FILE"
  fi
  return 1
}

start_process() {
  if status; then
    return 0
  fi
  if [ ! -x "$BIN" ]; then
    local msg="wxbackup binary not found or not executable: ${BIN}"
    log_msg "$msg"
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
      echo "$msg" >"$TRIM_TEMP_LOGFILE"
    fi
    return 1
  fi
  mkdir -p "$PKG_VAR" "$(data_dir)"
  log_msg "Starting ${BIN} on 127.0.0.1:${PORT} data=$(data_dir)"
  (
    cd "$PKG_VAR" || exit 1
    export WXBACKUP_PORT="$PORT"
    export WXBACKUP_DATA="$(data_dir)"
    exec "$BIN"
  ) >>"$LOG_FILE" 2>&1 &
  printf '%s' "$!" >"$PID_FILE"
  sleep 1
  if ! status; then
    local msg="wxbackup exited immediately; see ${LOG_FILE}"
    log_msg "$msg"
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
      echo "$msg" >"$TRIM_TEMP_LOGFILE"
    fi
    return 1
  fi
  return 0
}

stop_process() {
  if [ ! -r "$PID_FILE" ]; then
    return 0
  fi
  local pid
  pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
  if ! check_pid "$pid"; then
    rm -f "$PID_FILE"
    return 0
  fi
  log_msg "Stopping pid ${pid}"
  kill -TERM "$pid" 2>/dev/null || true
  local n=0
  while check_pid "$pid" && [ "$n" -lt 10 ]; do
    sleep 1
    n=$((n + 1))
  done
  if check_pid "$pid"; then
    kill -KILL "$pid" 2>/dev/null || true
    sleep 1
  fi
  rm -f "$PID_FILE"
  return 0
}

case "${1:-}" in
  start)
    start_process
    exit $?
    ;;
  stop)
    stop_process
    exit $?
    ;;
  status)
    if status; then
      exit 0
    fi
    exit 3
    ;;
  *)
    exit 1
    ;;
esac
